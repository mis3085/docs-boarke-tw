    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%83%86%e3%83%8e%e3%83%8a%e3%83%bc%e3%81%8a%e3%82%88%e3%81%b3%e3%83%a2%e3%83%ab%e3%83%86%e3%82%a3%e3%82%b5%e3%83%bc%e6%a9%9f%e6%a2%b0%e3%81%ae%e7%b4%b9%e4%bb%8b&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
