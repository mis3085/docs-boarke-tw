        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%85%90%eb%84%88-%eb%b0%8f-%eb%aa%a8%eb%a5%b4%ed%8b%b0%ec%84%9c-%ea%b8%b0%ea%b3%84-%ec%86%8c%ea%b0%9c&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
