        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e6%9c%a8%e6%9d%90%e3%81%ae%e3%81%8b%e3%82%93%e3%81%aa%e6%8e%9b%e3%81%91%e3%82%b8%e3%83%a7%e3%82%a4%e3%83%b3%e3%83%88%e5%8a%a0%e5%b7%a5%e3%83%a2%e3%83%bc%e3%83%ab%e3%83%87%e3%82%a3%e3%83%b3%e3%82%b0%e3%81%ae%e3%81%9f%e3%82%81%e3%81%ae%e7%b7%8f%e5%90%88%e3%82%bd%e3%83%aa%e3%83%a5%e3%83%bc%e3%82%b7%e3%83%a7%e3%83%b3&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
