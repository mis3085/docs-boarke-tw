    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#cnc%e5%8a%a0%e5%b7%a5%e4%b8%ad%e5%bf%83%e6%a9%9f%e7%9a%84%e5%a4%9a%e5%85%83%e6%87%89%e7%94%a8%e8%88%87%e5%89%b5%e6%96%b0%e8%a8%ad%e8%a8%88&#34; aria-label=&#34;定位點&#34;&gt;#&lt;/a&gt;
